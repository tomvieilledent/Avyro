# Copier en .env et adapter
HTTP_PORT=8080
FLASK_ENV=production

POSTGRES_USER=avyro
POSTGRES_PASSWORD=avyro
POSTGRES_DB=avyro

# Générer : python -c "import secrets; print(secrets.token_urlsafe(48))"
# Deux valeurs distinctes, >= 32 caractères (sinon refus en production)
SECRET_KEY=
JWT_SECRET_KEY=

# Obligatoires en production
PUBLIC_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080

# Email (rappel fournisseur 1 jour ouvré avant le début).
# Sans MAIL_SERVER, les emails sont écrits dans backend/dev_outbox.log.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@avyro.app

# Nombre de reverse proxies de confiance devant l'app (X-Forwarded-*). 0 = aucun.
TRUSTED_PROXY_COUNT=0

# Documentation API (Swagger/OpenAPI) : 1 pour activer
API_DOCS_ENABLED=0

# Stockage du rate limiting (par défaut mémoire, non partagé entre workers).
# Exemple Redis :
# RATELIMIT_STORAGE_URI=redis://redis:6379/0
