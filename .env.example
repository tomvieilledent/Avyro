# Copier en .env et adapter
HTTP_PORT=8080
FLASK_ENV=production

POSTGRES_USER=avyro
POSTGRES_PASSWORD=avyro
POSTGRES_DB=avyro

SECRET_KEY=change-me-in-prod
JWT_SECRET_KEY=change-me-in-prod

# Email (rappel fournisseur 1 jour ouvré avant le début).
# Sans MAIL_SERVER, les emails sont écrits dans backend/dev_outbox.log.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@avyro.app
